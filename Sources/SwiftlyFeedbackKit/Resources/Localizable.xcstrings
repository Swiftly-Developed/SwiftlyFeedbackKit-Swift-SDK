        "ja": { "stringUnit": { "state": "needs_review", "value": "このメールアドレスをサービスおよびアカウント関連のメールに登録します。" } },
        "zh-Hans": { "stringUnit": { "state": "needs_review", "value": "将此电子邮件地址订阅服务及账户邮件。" } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Inscreve este endereço de e-mail para receber e-mails de serviço e da conta." } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "이 이메일 주소를 서비스 및 계정 이메일에 구독합니다." } },
