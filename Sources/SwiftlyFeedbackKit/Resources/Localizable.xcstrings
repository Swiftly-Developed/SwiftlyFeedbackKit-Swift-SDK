    "accessibility.mailingList.marketing.hint": {
      "comment": "VoiceOver hint on the vote dialog's marketing-emails sub-toggle, shown when the mailing-list opt-in is enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribes this email address to product news and promotional emails."
          }
        },
        "es": { "stringUnit": { "state": "needs_review", "value": "Suscribe este correo electrónico a novedades del producto y correos promocionales." } },
        "fr": { "stringUnit": { "state": "needs_review", "value": "Abonne cette adresse e-mail aux actualités produit et aux e-mails promotionnels." } },
        "de": { "stringUnit": { "state": "needs_review", "value": "Meldet diese E-Mail-Adresse für Produktneuigkeiten und Werbe-E-Mails an." } },
        "ja": { "stringUnit": { "state": "needs_review", "value": "このメールアドレスを製品ニュースやプロモーションメールに登録します。" } },
        "zh-Hans": { "stringUnit": { "state": "needs_review", "value": "将此电子邮件地址订阅产品资讯和促销邮件。" } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Inscreve este endereço de e-mail para receber novidades do produto e e-mails promocionais." } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "이 이메일 주소를 제품 소식 및 프로모션 이메일에 구독합니다." } },
        "it": { "stringUnit": { "state": "needs_review", "value": "Iscrive questo indirizzo email alle novità sul prodotto e alle email promozionali." } },
        "ar": { "stringUnit": { "state": "needs_review", "value": "يشترك هذا البريد الإلكتروني في أخبار المنتج والرسائل الترويجية." } },
        "ru": { "stringUnit": { "state": "needs_review", "value": "Подписывает этот адрес электронной почты на новости продукта и рекламные рассылки." } }
      }
    },
    "accessibility.mailingList.operational.hint": {
