    "accessibility.voteDialog.notify.hint": {
      "comment": "VoiceOver hint on the vote dialog's notify-on-status-change toggle. Also explains why the toggle is disabled while no email address is entered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires an email address. Sends an email when this feedback's status changes."
          }
        },
        "es": { "stringUnit": { "state": "needs_review", "value": "Requiere un correo electrónico. Envía un correo cuando cambie el estado de este comentario." } },
        "fr": { "stringUnit": { "state": "needs_review", "value": "Nécessite une adresse e-mail. Envoie un e-mail lorsque le statut de ce retour change." } },
        "de": { "stringUnit": { "state": "needs_review", "value": "Erfordert eine E-Mail-Adresse. Sendet eine E-Mail, wenn sich der Status dieses Feedbacks ändert." } },
        "ja": { "stringUnit": { "state": "needs_review", "value": "メールアドレスが必要です。このフィードバックのステータスが変わるとメールを送信します。" } },
        "zh-Hans": { "stringUnit": { "state": "needs_review", "value": "需要电子邮件地址。此反馈的状态发生变化时会发送邮件。" } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Requer um endereço de e-mail. Envia um e-mail quando o status deste feedback mudar." } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "이메일 주소가 필요합니다. 이 피드백의 상태가 변경되면 이메일을 보냅니다." } },
        "it": { "stringUnit": { "state": "needs_review", "value": "Richiede un indirizzo email. Invia un'email quando lo stato di questo feedback cambia." } },
        "ar": { "stringUnit": { "state": "needs_review", "value": "يتطلب عنوان بريد إلكتروني. يرسل بريدًا إلكترونيًا عند تغيّر حالة هذه الملاحظة." } },
        "ru": { "stringUnit": { "state": "needs_review", "value": "Требуется адрес электронной почты. Отправляет письмо при изменении статуса этого отзыва." } }
